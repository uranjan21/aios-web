# =============================================================================
# Control Tower — PRODUCTION env (VPS)
#
#   cp .env.prod.example .env.prod    # on the VPS, at /opt/control-tower
#   chmod 600 .env.prod
#
# .env.prod is git-ignored. It is read by BOTH docker compose (for the
# ${...} substitutions in docker-compose.prod.yml) and the backend container
# (env_file). Never commit it.
# =============================================================================

# ---- Deployment ------------------------------------------------------------
# Set by the deploy workflow; pin them by hand only for a manual rollback.
BACKEND_IMAGE=ghcr.io/uranjan21/control-tower-backend:latest
FRONTEND_IMAGE=ghcr.io/uranjan21/control-tower-web:latest

# A hostname here makes Caddy provision a Let's Encrypt cert automatically.
# Hostinger gives every VPS a free srvNNNNNN.hstgr.cloud name (hPanel → VPS →
# Overview) that works for this — no purchase needed. Keep this and
# ALLOWED_ORIGIN below in the same scheme; they are edited together.
#
# ":80" is plain HTTP on the bare IP and no cert is possible. That path now
# also requires ALLOW_INSECURE_HTTP=true or the backend refuses to boot.
SITE_ADDRESS=srvNNNNNN.hstgr.cloud
ACME_EMAIL=utsavranjan.sk@gmail.com

# gunicorn workers. Rule of thumb: (2 × vCPU). Each worker opens its own DB
# pool, so don't push this past what Postgres max_connections (100) allows.
WEB_CONCURRENCY=2

# ---- Database (consumed by compose, NOT by the backend) ---------------------
# The backend's DATABASE_URL is assembled from these in docker-compose.prod.yml.
#
# DATABASE_URL and REDIS_URL are BOTH required by the backend (production
# refuses to boot without REDIS_URL) but must NOT be set here: compose injects
# them via `environment:`, which outranks this env_file. Setting them in this
# file is silently ignored. Change the topology in docker-compose.prod.yml if
# you point the app at an external Postgres or Redis.
DB_USER=control_tower
DB_NAME=control_tower
# openssl rand -base64 32 | tr -d '/+=' | head -c 40
DB_PASSWORD=CHANGE_ME

# ---- Backups — REQUIRED to be disaster-recoverable --------------------------
# deploy/backup-db.sh (installed as a nightly cron by deploy.sh) writes dumps to
# a directory on the SAME DISK as the database. That survives `docker compose
# down -v`; it does NOT survive losing the VPS. Set a remote and the dump is
# copied off-box after it is verified.
#   rclone remote:  BACKUP_REMOTE=s3:my-bucket/control-tower
#   s3 url (aws):   BACKUP_REMOTE=s3://my-bucket/control-tower
# Needs `rclone` (configured) or `aws` on PATH. Upload failures are logged and
# never fail a deploy. Leave blank and your real RPO on disk loss is total.
BACKUP_REMOTE=
BACKUP_DIR=/var/backups/control-tower
RETENTION_DAYS=14

# ---- App -------------------------------------------------------------------
ENVIRONMENT=production
# openssl rand -hex 32   (>=32 chars; production refuses to boot otherwise)
APP_SECRET_KEY=CHANGE_ME
# Legacy single-user login. Ignored in production, but the config validator
# still rejects the known defaults — set it to anything non-default.
APP_PASSWORD=CHANGE_ME
APP_EMAIL=utsavranjan.sk@gmail.com

# MUST match the address users type in the browser, scheme included.
# Drives CORS, the CSP connect-src (incl. the ws:// origin) AND whether the
# auth cookie gets the Secure flag. Getting this wrong = broken login.
#
# Prefer https from day one. A Hostinger VPS already has a free
# srvNNNNNN.hstgr.cloud hostname that Let's Encrypt accepts, so you do NOT have
# to buy a domain to get TLS — set SITE_ADDRESS to that hostname and put
# https:// here. See docs/DEPLOYMENT.md §4.
ALLOWED_ORIGIN=https://srvNNNNNN.hstgr.cloud

# Production REFUSES TO START on a non-https ALLOWED_ORIGIN unless this is true.
# Without TLS the auth cookie cannot carry Secure, so every JWT — and all the
# financial and health data behind it — crosses the network in cleartext.
# Setting this to true is a deliberate, temporary choice, not a default.
ALLOW_INSECURE_HTTP=false

# Extra hosts appended to the EDGE Content-Security-Policy connect-src (Caddy,
# frontend/Caddyfile). Space-separated. The SPA is allowed 'self' + ipapi.co +
# open.er-api.com out of the box; anything else the browser calls directly —
# Sentry's ingest host, PostHog — must be listed here or it is blocked.
# Example: CSP_CONNECT_EXTRA=https://us.i.posthog.com https://o123456.ingest.sentry.io
CSP_CONNECT_EXTRA=

# ---- Vault sync — OFF -------------------------------------------------------
# Single shared filesystem, NOT isolated per user. Production refuses to start
# with this on unless VAULT_SINGLE_TENANT_ACK=true.
VAULT_SYNC_ENABLED=false
VAULT_SINGLE_TENANT_ACK=false
VAULT_PATH=/tmp/vault

# ---- AI --------------------------------------------------------------------
# Only "openai" or "anthropic" are valid — anything else (e.g. the old
# "nvidia") makes pydantic reject the settings and the container crash-loops.
#
# BRING YOUR OWN KEY: there is deliberately NO instance-level OPENAI_API_KEY or
# ANTHROPIC_API_KEY. Each user pastes their own provider key in
# Settings -> AI & knowledge; it is stored Fernet-encrypted in `user_api_keys`
# and their provider bills them directly. The server never spends money on a
# user's behalf, which is why this deployment needs no quota, no metering and
# no per-user cap — and why a public signup page cannot run up your bill.
# DO NOT reintroduce a shared server key "for convenience". That single change
# is what forced the AI credit system that used to live here.
# The settings below select the DEFAULT MODEL. They are not credentials.
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Email — REQUIRED in production ----------------------------------------
# Signup requires a verified email; without this the container refuses to boot.
# Free tier at https://resend.com.
RESEND_API_KEY=
EMAIL_FROM=Control Tower <noreply@yourdomain.com>

# ---- Encryption — REQUIRED in production ------------------------------------
# Protects users' own LLM API keys as well as OAuth tokens, so production
# refuses to boot without it. Rotating it makes every stored key and token
# unreadable — users would have to re-enter them. Back it up with your secrets.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Integrations (optional) -----------------------------------------------
# Every deploy origin needs these redirect URIs registered in the Google Cloud
# OAuth client:  <origin>/auth/google/callback
#                <origin>/integrations/{gmail,gcal,gfit}/callback
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GFIT_CLIENT_ID=
GFIT_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=120

# ---- Web push (optional) ---------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:utsavranjan.sk@gmail.com

# ---- Observability — NOT optional if you have real users --------------------
# LEAVING SENTRY_DSN EMPTY MEANS PRODUCTION ERRORS ARE INVISIBLE. There is no
# /metrics endpoint and container logs rotate at 10MB × 3 on the box, so an
# unset DSN is the difference between "a user tells you it broke, eventually"
# and knowing. Free tier: https://sentry.io → Project → Client Keys (DSN).
#
# Set BOTH:
#   SENTRY_DSN            — backend, read at runtime (app/core/observability.py)
#   VITE_SENTRY_DSN       — frontend, BUILD-TIME ONLY. It is a Docker build arg
#                           in the deploy workflow, so it must be a GitHub repo
#                           secret; putting it here does nothing.
#
# When a DSN is set you MUST also add its ingest host to CSP_CONNECT_EXTRA
# above, or the browser blocks every frontend error report and the backend
# looks like the only thing that ever fails. Read the host off the DSN:
#   https://<key>@o123456.ingest.sentry.io/456  →  https://o123456.ingest.sentry.io
SENTRY_DSN=
# Fraction of transactions traced for performance. 0.0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0.0

