# =============================================================================
# Control Tower — PRODUCTION environment
#
# These are set in your hosting platform's dashboard (Render, Railway, Fly), not
# in a file on a server. This file is the manifest of what to set and why.
# Nothing here is a secret; every real value is generated or copied from a
# provider console.
#
#   Fly:      fly secrets set KEY=value ...
#   Render:   filled in when the Blueprint prompts, or Dashboard → Environment
#   Railway:  Variables tab
#
# The full walkthrough is docs/DEPLOYMENT.md.
# =============================================================================

# ---- Required: identity of the deployment ----------------------------------
ENVIRONMENT=production

# EXACTLY what users type in the browser, scheme included and no trailing slash.
# It drives CORS, the CSP connect-src (including the ws:// origin) AND whether
# the auth cookie carries the Secure flag. A mismatch here does not error — it
# just makes login silently fail, which is the single most common way this
# deployment goes wrong.
#   https://control-tower.onrender.com   |   https://control-tower.fly.dev
ALLOWED_ORIGIN=https://your-app.example.com

# Production REFUSES TO BOOT on a non-https ALLOWED_ORIGIN unless this is true.
# Without TLS the auth cookie cannot carry Secure, so every JWT — and all the
# financial and health data behind it — crosses the network in cleartext. Every
# platform above gives you HTTPS by default, so you should never need this.
ALLOW_INSECURE_HTTP=false

# ---- Required: database (Supabase) ------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Change the scheme from `postgresql://` to `postgresql+asyncpg://` and keep the
# rest as printed. app/db/url.py translates `sslmode` to what asyncpg actually
# accepts and strips anything it does not, so you can paste the URI as-is.
#
# PREFER THE TRANSACTION POOLER (port 6543). It is reachable over IPv4 — the
# direct connection on 5432 is IPv6-only for new projects, which several hosts
# cannot reach — and it holds far fewer server-side connections. The app detects
# that port and disables statement caching accordingly; without that, asyncpg
# raises DuplicatePreparedStatementError under load.
#
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ---- Required: Redis / Key Value --------------------------------------------
# Rate-limit counters and pending tool-call state. Production refuses to boot
# without it: with more than one worker, per-process counters mean each worker
# enforces the limit separately and the effective limit is N times what you
# configured.
#   Render — provisioned by render.yaml, injected automatically
#   Fly    — fly redis create
#   Railway— add a Redis service
REDIS_URL=

# ---- Required: secrets -------------------------------------------------------
# Signs every JWT. Must be identical across workers and across restarts, or
# users are logged out at random with nothing in the logs.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Legacy single-user login. Ignored in production, but the config validator
# still rejects the known defaults, so set it to anything of your own.
APP_PASSWORD=

# Encrypts each user's own LLM API key at rest, and their OAuth tokens.
# ROTATING THIS MAKES EVERY STORED KEY AND TOKEN PERMANENTLY UNREADABLE — users
# would have to re-enter them. Back it up with your other secrets.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Required: email ---------------------------------------------------------
# Signup is gated on a verified address, so the app refuses to boot without a
# way to send. Free tier at https://resend.com.
RESEND_API_KEY=
EMAIL_FROM=Control Tower <noreply@your-domain.example>

# ---- Required: vault sync stays off ------------------------------------------
# Vault sync is single-tenant: ONE shared filesystem, not isolated per user.
# Turning it on in a hosted deployment exposes every user's vault to every other
# user. The backend refuses to start with it on in production unless
# VAULT_SINGLE_TENANT_ACK=true, which exists so that can only ever be deliberate.
VAULT_SYNC_ENABLED=false
VAULT_SINGLE_TENANT_ACK=false

# ---- Sizing ------------------------------------------------------------------
# gunicorn workers. Each holds its own database pool, so the connection count is
# roughly WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW). Keep that under
# your provider's cap — or point DATABASE_URL at the transaction pooler, which
# is what it is for.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- AI: bring your own key --------------------------------------------------
# There is deliberately NO instance-level OPENAI_API_KEY or ANTHROPIC_API_KEY.
# Every user pastes their own provider key in Settings → AI & knowledge; it is
# stored Fernet-encrypted and their provider bills them directly. The server
# never spends money on a user's behalf, which is what lets this app be free,
# uncapped, and open to public signup without a quota system.
#
# DO NOT add a shared server key "for convenience". That one change is what
# forced the AI credit metering this project spent months building and removing.
# The two settings below choose a DEFAULT MODEL. They are not credentials.
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Observability — set this before you have real users ---------------------
# Unset means production errors are invisible: there is no metrics endpoint and
# platform logs are all you get. Free tier: https://sentry.io → Client Keys.
#
# Two separate variables, and they are not interchangeable:
#   SENTRY_DSN       backend, read at runtime
#   VITE_SENTRY_DSN  frontend, BUILD-TIME ONLY. Vite inlines it into the bundle,
#                    so it must be a Docker build arg (a GitHub repo secret,
#                    used by .github/workflows/deploy.yml). Setting it as a
#                    runtime variable does nothing at all.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Hosts the browser is allowed to call, appended to the CSP connect-src,
# space-separated. The SPA may otherwise reach only its own origin plus the two
# currency APIs. If SENTRY_DSN is set, its ingest host MUST be listed here or
# every frontend error report is silently blocked — read the host off the DSN:
#   https://<key>@o123456.ingest.sentry.io/456 → https://o123456.ingest.sentry.io
CSP_CONNECT_EXTRA=

# ---- Optional: integrations --------------------------------------------------
# Each deploy origin needs these exact redirect URIs registered on the Google
# Cloud OAuth client, or the connect flow fails after the consent screen:
#   <origin>/auth/google/callback
#   <origin>/integrations/gmail/callback
#   <origin>/integrations/gcal/callback
#   <origin>/integrations/gfit/callback
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GFIT_CLIENT_ID=
GFIT_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional: web push ------------------------------------------------------
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys()"
# VAPID_SUBJECT must be a contact URI you own (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=120
