# =============================================================================
# Control Tower — edge config (baked into the web image)
#
# SITE_ADDRESS controls HTTP vs HTTPS and is the ONLY thing you change to go
# from bare-IP to a real domain:
#
#   SITE_ADDRESS=:80                 → plain HTTP (bare IP, no cert possible)
#   SITE_ADDRESS=app.example.com     → Caddy auto-provisions a Let's Encrypt
#                                      cert and redirects HTTP→HTTPS by itself
#
# When you switch, also set ALLOWED_ORIGIN=https://app.example.com in .env.prod
# so CORS, the CSP connect-src and the Secure cookie flag all line up.
# =============================================================================
{
	# No admin API — it would otherwise listen on 2019 inside the container.
	admin off
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# ---- security headers ----------------------------------------------------
	# These apply to the SPA DOCUMENT. The FastAPI SecurityHeadersMiddleware only
	# ever decorated /api/* JSON responses, so until now index.html shipped with
	# no CSP and no anti-framing header at all — a financial app that could be
	# iframed. `header` here sets them on every response Caddy emits, including
	# the proxied ones (Caddy's header runs after the upstream reply, and
	# duplicate-safe because we set, not add).
	#
	# CSP notes — do not tighten these without re-testing the live app:
	#  * style-src needs 'unsafe-inline' for styled-components' injected <style>
	#    and fonts.googleapis.com for the webfont CSS in index.html.
	#  * font-src needs fonts.gstatic.com — the actual DM Sans / Playfair files.
	#    Drop either and the whole type system silently falls back to system UI.
	#  * connect-src 'self' covers same-origin ws:// and wss:// under CSP3.
	#    CSP_CONNECT_EXTRA is where Sentry's per-project ingest host and PostHog
	#    go when those are enabled — they are NOT allowed by default.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Ignored by browsers over plain http, so it is safe on the bare-IP setup
		# and correct the moment SITE_ADDRESS becomes a hostname.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://ipapi.co https://open.er-api.com {$CSP_CONNECT_EXTRA:}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the edge version.
		-Server
	}

	# ---- backend -------------------------------------------------------------
	# /health is proxied too so an external uptime monitor can hit it without
	# knowing the /api prefix.
	@backend path /api/* /health
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	# WebSockets (/ws/sync, /ws/chat, /ws/agents). Caddy upgrades these
	# transparently — no extra Connection/Upgrade headers needed.
	handle /ws/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
			# Chat streams can idle between tokens; don't cut them at the default.
			transport http {
				read_timeout 300s
			}
		}
	}

	# ---- SPA -----------------------------------------------------------------
	handle {
		root * /srv

		# Vite emits content-hashed filenames under /assets — safe to cache
		# forever. index.html must never be cached or users get pinned to a
		# stale bundle after a deploy.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache, must-revalidate"

		# React Router owns client-side routing: any unknown path returns the
		# shell. Without this, refreshing /app/finance is a hard 404.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
