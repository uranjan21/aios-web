# ============================================================
# Control Tower — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to git.
# ============================================================

# App
ENVIRONMENT=development          # MUST be "production" when deployed — gates Secure cookies,
                                 #   the legacy login backdoor, and secret-strength validation.
APP_SECRET_KEY=                  # JWT signing key — generate: openssl rand -hex 32
APP_PASSWORD=                    # Legacy single-user password (DEV ONLY; ignored in production)
ALLOWED_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://control_tower:control_tower_dev_password@localhost:5432/control_tower

# Redis — REQUIRED for rate limiting when running >1 worker (autoscaled/multi-worker).
# Without it the limiter is per-process memory: limits multiply by worker count and
# reset on deploy, weakening abuse/cost protection. Leave blank for single-worker/dev.
REDIS_URL=

# Vault — SINGLE-TENANT ONLY (one shared filesystem, NOT isolated per user).
# In a hosted multi-tenant SaaS this leaks every user's vault to every user —
# set VAULT_SYNC_ENABLED=false. Production will REFUSE TO START with vault sync on
# unless VAULT_SINGLE_TENANT_ACK=true (deliberate self-host single-tenant deploy).
VAULT_SYNC_ENABLED=true
VAULT_SINGLE_TENANT_ACK=false
VAULT_PATH=/absolute/path/to/your/obsidian-vault
VAULT_WATCH_INTERVAL_SECONDS=5

# AI — BRING YOUR OWN KEY
# There is deliberately NO instance-level OPENAI_API_KEY / ANTHROPIC_API_KEY.
# Control Tower never calls an LLM on its own account: each user pastes their
# own provider key in Settings -> AI & knowledge, it is stored Fernet-encrypted
# in `user_api_keys`, and their usage is billed by their provider directly to
# them. That is what lets the app be free and uncapped for everyone.
# A shared server key would mean any signup could spend the operator's money
# without limit, which is exactly why this app used to need quotas and metering.
# The settings below choose WHICH MODEL is used; they are not credentials.
LLM_PROVIDER=openai              # default provider: "openai" | "anthropic"
OPENAI_CHAT_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_DAILY_TOKEN_LIMIT=200000
CLAUDE_SESSION_TOKEN_LIMIT=50000

# Encryption — REQUIRED. Protects users' own LLM API keys as well as OAuth
# tokens, so production refuses to boot without it. Rotating it makes every
# stored key and token unreadable; users would have to re-enter them.
TOKEN_ENCRYPTION_KEY=            # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Integrations (filled after OAuth setup)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GFIT_CLIENT_ID=
GFIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate limiting (overrides defaults if set)
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=120

# Observability — all opt-in. Leave blank in dev/self-host (nothing is sent).
# Backend error reporting (scrubs bodies/cookies/auth headers before sending):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Frontend build-time vars (must be prefixed VITE_ to reach the browser bundle).
# Frontend error reporting + product analytics (5 activation events only):
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Web push (VAPID) — generate with: docker compose exec backend python -c "from py_vapid import Vapid01; ..."
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
