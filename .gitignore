# Environment Variables
# Deny-by-default. An explicit list of filenames misses the next one someone
# invents, and this repository is public — a single committed .env would publish
# the signing key, the encryption key and the database password at once.
.env
.env.*
!.env.example
!.env.production.example

# Python
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
build/
.venv/
venv/
env/
.Python

# Node
node_modules/
dist/
build/
*.tsbuildinfo
.pnpm-debug.log

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Data
pgdata/
*.db
*.sqlite
*.sqlite3

# Credentials & Secrets
*.pem
*.key
*.crt
.ssl/
secrets/
.credentials
config/secrets.json

# Build & Temp
dist/
build/
.cache/
.next/
out/
temp/
tmp/

# IDE specific
.eslintcache
.prettierignore

# Docker
# .dockerignore is deliberately NOT ignored — it defines the build context for
# the images CI builds. Ignoring it meant GitHub Actions built from a context
# with no exclusions at all.
docker-compose.override.yml

# Graphify
graphify-out/

# AI Assistants & Subagents
# Local agent state stays out of git, but SKILLS are project assets and must be
# versioned (frontend/.claude/skills/, backend/.claude/skills/). Git cannot
# re-include a path whose parent DIRECTORY is excluded, so these patterns
# exclude the directory's CONTENTS (`.claude/*`) rather than the directory
# itself (`.claude/`) — otherwise the `!` negation below would never apply.
.agents/
.agent/
.gemini/
**/.claude/*
!**/.claude/skills/
